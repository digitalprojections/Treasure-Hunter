{
  "name": "treasure-hunter",
  "private": true,
  "version": "0.0.33",
  "type": "module",
  "scripts": {
    "test:music": "tsx --test src/utils/musicPlayer.test.ts src/utils/musicTransitions.test.ts src/utils/musicFlow.test.ts src/utils/audio.test.ts",
    "test:combat-rendering": "tsx scripts/verify-combat-rendering.ts",
    "assets:check": "tsx scripts/check-asset-conventions.ts",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:branding": "node scripts/check-branding.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "build:treasuremaps": "vite build --base /treasuremaps/",
    "deploy:treasuremaps": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-treasuremaps.ps1",
    "assets:inspect": "tsx scripts/inspect-character-assets.ts",
    "assets:objects": "tsx scripts/inspect-object-assets.ts",
    "test:defense-rendering": "tsx scripts/verify-defense-rendering.ts",
    "test:gameplay": "tsx --test src/utils/interactions.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-firebase-hooks": "^5.1.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
